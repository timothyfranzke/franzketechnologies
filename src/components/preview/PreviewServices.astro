---
import type { ProspectSite } from "../../lib/preview/schema";
import { paletteFor } from "../../lib/preview/palette";

interface Props {
  data: ProspectSite;
}

const { data } = Astro.props;
const palette = paletteFor(data.vertical);
---

<section class="preview-services" style={`--accent: ${palette.accent}; --ink: ${palette.ink};`}>
  <div class="preview-services-inner">
    <p class="preview-eyebrow">What we do</p>
    <h2 class="preview-section-title">Services</h2>
    <ul class="preview-services-grid">
      {data.services.map((service) => (
        <li class="preview-service-card">
          <span class="preview-service-bullet" aria-hidden="true"></span>
          <span class="preview-service-text">{service}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .preview-services {
    padding: 80px 24px;
    background: #ffffff;
    color: var(--ink);
  }

  .preview-services-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .preview-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }

  .preview-section-title {
    font-family: "Bebas Neue", "Poppins", sans-serif;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0 0 48px;
  }

  .preview-services-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .preview-service-card {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 24px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fafafa;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .preview-service-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .preview-service-bullet {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: 8px;
    flex-shrink: 0;
  }

  .preview-service-text {
    font-size: 1rem;
    line-height: 1.5;
  }
</style>
