---
import type { ProspectSite } from "../../lib/preview/schema";
import { paletteFor } from "../../lib/preview/palette";

interface Props {
  data: ProspectSite;
}

const { data } = Astro.props;
const palette = paletteFor(data.vertical);

const dayOrder = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"];
const hoursEntries = data.hours
  ? dayOrder
      .filter((day) => data.hours![day])
      .map((day) => ({ day, value: data.hours![day] }))
  : [];

const mapsUrl = data.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(data.address)}`
  : null;
---

<section class="preview-hours">
  <div class="preview-hours-inner" style={`--accent: ${palette.accent};`}>
    <div class="preview-hours-block">
      <p class="preview-eyebrow">Hours</p>
      <h2 class="preview-section-title">When we're open</h2>
      {hoursEntries.length > 0 ? (
        <dl class="preview-hours-list">
          {hoursEntries.map(({ day, value }) => (
            <div class="preview-hours-row">
              <dt>{day.charAt(0).toUpperCase() + day.slice(1)}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="preview-hours-empty">Call or message us for current hours.</p>
      )}
    </div>

    <div class="preview-location-block">
      <p class="preview-eyebrow">Find us</p>
      <h2 class="preview-section-title">Location</h2>
      {data.address && (
        <address class="preview-address">{data.address}</address>
      )}
      {mapsUrl && (
        <a class="preview-maps-link" href={mapsUrl} target="_blank" rel="noopener">
          Open in Google Maps →
        </a>
      )}
      {data.phone && (
        <p class="preview-phone">
          <a href={`tel:${data.phone.replace(/[^0-9+]/g, "")}`}>{data.phone}</a>
        </p>
      )}
    </div>
  </div>
</section>

<style>
  .preview-hours {
    background: #ffffff;
    padding: 80px 24px;
    border-top: 1px solid #f3f4f6;
    border-bottom: 1px solid #f3f4f6;
  }

  .preview-hours-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 48px;
  }

  .preview-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 14px;
  }

  .preview-section-title {
    font-family: "Bebas Neue", "Poppins", sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0 0 24px;
  }

  .preview-hours-list {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    max-width: 420px;
  }

  .preview-hours-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #f3f4f6;
  }

  .preview-hours-row dt {
    font-weight: 600;
  }

  .preview-hours-row dd {
    margin: 0;
    color: #4b5563;
  }

  .preview-address {
    font-style: normal;
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 12px;
  }

  .preview-maps-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .preview-maps-link:hover {
    text-decoration: underline;
  }

  .preview-phone {
    margin-top: 18px;
    font-size: 1.1rem;
  }

  .preview-phone a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .preview-hours-empty {
    color: #6b7280;
  }
</style>
