---
import type { ClientItem } from "../../../lib/clients/schema";

interface Props {
  item: Extract<ClientItem, { type: "pdf" }>;
}

const { item } = Astro.props;
const label = item.caption ?? "PDF document";
---

<a href={item.src} target="_blank" rel="noopener noreferrer" class="pdf-item">
  <span class="icon" aria-hidden="true">PDF</span>
  <span class="label">{label}</span>
  <span class="action">Open PDF &rarr;</span>
</a>

<style>
  .pdf-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    background: #ffffff;
    color: #111827;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .pdf-item:hover {
    border-color: #cbd5e1;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    text-decoration: none;
  }

  .icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: #fee2e2;
    color: #b91c1c;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .label {
    flex: 1;
    font-weight: 500;
  }

  .action {
    flex-shrink: 0;
    font-size: 0.875rem;
    color: #1d4ed8;
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .action {
      display: none;
    }
  }
</style>
