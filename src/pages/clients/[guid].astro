---
import fs from "node:fs";
import path from "node:path";
import { parseClientPage, type ClientPage } from "../../lib/clients/schema";
import ClientLayout from "../../layouts/ClientLayout.astro";

export async function getStaticPaths() {
  const contentDir = path.resolve("src/content/clients");
  if (!fs.existsSync(contentDir)) return [];

  const files = fs.readdirSync(contentDir).filter((f) => f.endsWith(".json"));

  return files.map((file) => {
    const raw = fs.readFileSync(path.join(contentDir, file), "utf-8");
    const data = parseClientPage(JSON.parse(raw), file);
    return { params: { guid: data.guid }, props: { data } };
  });
}

type Props = { data: ClientPage };
const { data } = Astro.props as Props;
---

<ClientLayout data={data} />
