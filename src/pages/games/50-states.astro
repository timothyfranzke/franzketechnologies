---
import '../../styles/game.css';
import StatesCapitalsGame from '../../components/StatesCapitalsGame.jsx';

const title = 'Nifty Fifty — States & Capitals Game';
const description = 'Test your knowledge of all 50 US state capitals and abbreviations with quizzes, typing challenges, speed rounds, and flashcards.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-50-states-abv.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-50-states-abv.png" />
    <!-- PWA -->
    <link rel="manifest" href="/games/nifty-fifty-manifest.json" />
    <meta name="theme-color" content="#1A2537" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Nifty Fifty" />
    <link rel="apple-touch-icon" href="/games/nifty-fifty-192.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body style="margin: 0; padding: 0;">
    <div style="position: fixed; top: 16px; left: 16px; z-index: 50;">
      <a
        href="/"
        style="font-family: system-ui, sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #8A7E68; text-decoration: none; opacity: 0.7; transition: opacity 0.2s;"
        onmouseover="this.style.opacity='1'"
        onmouseout="this.style.opacity='0.7'"
      >
        &larr; franzketechnologies.com
      </a>
    </div>
    <StatesCapitalsGame client:only="react" />
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/games/nifty-fifty-sw.js");
      }
    </script>
  </body>
</html>
