---
import '../../styles/game.css';
import JustTheFactsGame from '../../components/JustTheFactsGame.jsx';

const title = 'Just the Facts — Multiplication Game';
const description = 'Fast multiplication practice for every fact from 1×1 to 12×12. Adaptive rounds focus on the facts you still need.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- TODO: dedicated OG image for Just the Facts -->
    <meta property="og:image" content="/og-50-states-abv.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/og-50-states-abv.png" />
    <!-- PWA -->
    <link rel="manifest" href="/games/just-the-facts-manifest.json" />
    <meta name="theme-color" content="#1F7A6D" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Just the Facts" />
    <link rel="apple-touch-icon" href="/games/just-the-facts-192.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body style="margin: 0; padding: 0; background: #EADFC6;">
    <div style="position: fixed; top: 16px; left: 16px; z-index: 50;">
      <a
        href="/"
        style="font-family: system-ui, sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: #8A7E68; text-decoration: none; opacity: 0.7; transition: opacity 0.2s;"
        onmouseover="this.style.opacity='1'"
        onmouseout="this.style.opacity='0.7'"
      >
        &larr; franzketechnologies.com
      </a>
    </div>
    <JustTheFactsGame client:only="react" />
    <script>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/games/just-the-facts-sw.js");
      }
    </script>
  </body>
</html>
