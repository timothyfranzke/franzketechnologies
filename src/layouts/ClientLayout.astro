---
import type { ClientPage } from "../lib/clients/schema";
import ClientHeader from "../components/client/ClientHeader.astro";
import ClientSection from "../components/client/ClientSection.astro";

interface Props {
  data: ClientPage;
}

const { data } = Astro.props;
const title = data.title ?? `${data.client} — Project Resources`;
const description = `Project resources for ${data.client}, prepared by Franzke Technologies.`;
const updatedLabel = data.updatedAt ? formatDate(data.updatedAt) : null;

function formatDate(iso: string): string {
  const [y, m, d] = iso.split("-").map(Number);
  if (!y || !m || !d) return iso;
  const date = new Date(Date.UTC(y, m - 1, d));
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page">
      <ClientHeader client={data.client} />

      {data.intro && <p class="intro">{data.intro}</p>}

      <div class="sections">
        {data.sections.map((section) => <ClientSection section={section} />)}
      </div>

      <footer class="footer">
        {updatedLabel && <span>Last updated {updatedLabel}</span>}
        {updatedLabel && <span class="divider">·</span>}
        <span>
          Prepared by
          <a href="https://franzketechnologies.com">Franzke Technologies</a>
        </span>
      </footer>
    </div>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Poppins", system-ui, -apple-system, sans-serif;
        font-size: 16px;
        line-height: 1.6;
        color: #1f2937;
        background: #fafaf7;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: #1d4ed8;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }
    </style>

    <style>
      .page {
        max-width: 800px;
        margin: 0 auto;
        padding: 3rem 1.25rem 5rem;
      }

      .intro {
        margin: 0 0 3rem;
        font-size: 1.0625rem;
        color: #374151;
        line-height: 1.7;
      }

      .sections {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
      }

      .footer {
        margin-top: 5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
        font-size: 0.875rem;
        color: #6b7280;
        text-align: center;
      }

      .footer a {
        color: #6b7280;
        text-decoration: underline;
      }

      .divider {
        margin: 0 0.5rem;
      }

      @media (max-width: 640px) {
        .page {
          padding: 2rem 1rem 3rem;
        }
      }
    </style>
  </body>
</html>
