rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Clients collection — authenticated users only
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
    }

    // Rate limits — authenticated users only
    match /rateLimits/{clientId} {
      allow read, write: if request.auth != null;
    }

    // Speed scores — open for the games
    match /speed-scores/{document=**} {
      allow read, write: if true;
    }

    // Vacation expense splitter — open like the games, 6-char code is the secret
    match /trips/{tripId} {
      allow read, write: if true;
      match /expenses/{expenseId} {
        allow read, write: if true;
      }
    }
  }
}
